local function new(c, pr, props)
    local i = Instance.new(c, pr)
    for k, v in pairs(props) do
        if k == "_cr" then
            local x = Instance.new("UICorner", i)
            x.CornerRadius = v
        elseif k == "_st" then
            local x = Instance.new("UIStroke", i)
            x.Color = Theme.Border
            x.Thickness = 1
            x.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        else
            i[k] = v
        end
    end
    return i
end

local function tw(o, info, p, cb)
    local t = TweenService:Create(o, info, p)
    if cb then t.Completed:Connect(cb) end
    t:Play()
    return t
end

