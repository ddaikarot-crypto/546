local function MakeBtn(Text, Size, Order)
    local Btn = new("TextButton", BtnContainer, {
        Size = Size,
        Text = Text,
        BackgroundColor3 = Theme.ButtonBg,
        TextColor3 = Theme.Text,
        Font = F,
        TextSize = 12,
        BorderSizePixel = 0,
        LayoutOrder = Order,
        _cr = UDim.new(0, 3),
        _st = true
    })
    new("UIPadding", Btn, { PaddingBottom = UDim.new(0, 2) })
    Btn.MouseEnter:Connect(function() tw(Btn, TweenInfo.new(0.1), { BackgroundColor3 = Color3.fromRGB(65, 65, 73) }) end)
    Btn.MouseLeave:Connect(function() tw(Btn, TweenInfo.new(0.1), { BackgroundColor3 = Theme.ButtonBg }) end)
    return Btn
end

