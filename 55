local function Header(Text, Container)
    local H = new("TextButton", Content, {
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundColor3 = Theme.HeaderBg,
        TextColor3 = Theme.Text,
        Font = F,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        BorderSizePixel = 0,
        Text = "      " .. Text,
        _cr = UDim.new(0, 3),
        _st = true
    })
    new("UIPadding", H, { PaddingBottom = UDim.new(0, 2) })
    local A = new("TextLabel", H, {
        Size = UDim2.new(0, 24, 1, 0),
        Position = UDim2.new(0, 4, 0, 0),
        BackgroundTransparency = 1,
        TextColor3 = Theme.Text,
        Font = F,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Center
    })
    local Open = true
    local fullH = Container.Size.Y.Offset
    Container.ClipsDescendants = false
    local function u() A.Text = Open and "▲" or "▶" end
    u()
    H.MouseButton1Click:Connect(function()
        Open = not Open
        u()
        if Open then
            Container.Visible = true
            tw(Container, TweenInfo.new(0.2, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, fullH) }, function()
                if Open then Container.ClipsDescendants = false end
            end)
        else
            Container.ClipsDescendants = true
            tw(Container, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(1, 0, 0, 0) }, function()
                if not Open then Container.Visible = false end
            end)
        end
    end)
end

