local MainScale = new("UIScale", Main, { Scale = 0 })

local function Toggle(v)
    if v then
        Main.Visible = true
        tw(MainScale, TweenInfo.new(0.2, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { Scale = 0.85 })
    else
        tw(MainScale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0 }, function()
            if MainScale.Scale == 0 then Main.Visible = false end
        end)
    end
end

local TitleBar = new("Frame", Main, {
